# Copy to .env (git-ignored) and fill in after Phase 0 confirmation.
# The loader/report/check commands run fully offline without these.

# MAS Manage host only, e.g. myinstance.manage.ibm.com (no scheme, no path)
MAXIMO_HOST=

# API key created for the trial user. Sent as the `apikey` header (VERIFY).
MAXIMO_APIKEY=

# Site / organisation IDs to use (VERIFY during Phase 0)
MAXIMO_SITE_ID=BISHA-BESS
MAXIMO_ORG_ID=BISHA

# false until Phase 0 confirms API access; keeps live calls behind an explicit opt-in
MAXIMO_LIVE_ENABLED=false

# Optional tuning
MAXIMO_TIMEOUT_SECONDS=30
MAXIMO_MAX_RETRIES=4
MAXIMO_PAGE_SIZE=100
